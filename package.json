{
  "name": "tallalab",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Tallaje escolar guiado con cámara y referencias verificables",
  "scripts": {
    "build": "node scripts/preparar.mjs",
    "vision:setup": "node scripts/instalar-vision.mjs",
    "vision:verify": "node scripts/instalar-vision.mjs --verify-only",
    "test": "node --test tests/engine.test.mjs",
    "test:ui": "node tests/ui-check.cjs",
    "dev": "node scripts/servidor-pruebas.mjs",
    "deploy": "firebase deploy --only hosting"
  }
}
